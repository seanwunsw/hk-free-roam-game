# Python
**/__pycache__/
**/*.pyc
.pytest_cache/
.venv/
venv/

# Source downloads. Regenerate with the URLs in data/README.md.
data/raw/

# Unreal generated
UnrealProject/Binaries/
UnrealProject/Build/
UnrealProject/Intermediate/
UnrealProject/Saved/
UnrealProject/DerivedDataCache/
UnrealProject/.vs/
UnrealProject/*.sln
UnrealProject/*.suo
UnrealProject/*.opensdf
UnrealProject/*.sdf
UnrealProject/*.VC.db
UnrealProject/*.VC.opendb
UnrealProject/Content/*
!UnrealProject/Content/Python/
!UnrealProject/Content/Python/**

# The baked map and meshes are created on the owner's machine.
*.uasset
*.umap
!UnrealProject/Content/Python/**

# Third-party plugins fetched by tools/get_vrm4u.ps1 (pinned + SHA-256 checked).
UnrealProject/Plugins/VRM4U/

# Plugin build output (built locally per machine)
UnrealProject/Plugins/**/Binaries/
UnrealProject/Plugins/**/Intermediate/

# Editor and IDE settings
.vscode/
.idea/
*.code-workspace
.vsconfig

# Pipeline run logs are regenerated by tools/pipeline/build_world.py on every run
data/processed/logs/
